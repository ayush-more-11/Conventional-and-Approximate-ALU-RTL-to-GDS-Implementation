create_clock -name clk -period 10.0 -waveform {0 5.0} [get_ports "clk"]
set_clock_transition -rise 0.1 [get_clocks "clk"]
set_clock_transition -fall 0.1 [get_clocks "clk"]
set_clock_uncertainty 0.01 [get_ports "clk"]
set_input_delay -max 1.0 [get_ports "rst_n"] -clock [get_clocks "clk"]
set_input_delay -max 1.0 [get_ports {A[*] B[*] ALU_Sel[*]}] -clock [get_clocks "clk"]
set_output_delay -max 1.0 [get_ports {ALU_Out[*] CarryOut}] -clock [get_clocks "clk"]
